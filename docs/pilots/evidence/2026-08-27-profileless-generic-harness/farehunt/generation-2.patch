diff --git a/src/components/shared/FlightSearchForm.test.tsx b/src/components/shared/FlightSearchForm.test.tsx
new file mode 100644
index 0000000..cfd00d7
--- /dev/null
+++ b/src/components/shared/FlightSearchForm.test.tsx
@@ -0,0 +1,71 @@
+import { fireEvent } from "@testing-library/react";
+import { cloneElement, createElement, Fragment, type InputHTMLAttributes, type ReactElement } from "react";
+import { describe, expect, it, vi } from "vitest";
+import { FlightSearchForm } from "@/components/shared/FlightSearchForm";
+import { render, screen } from "@/tests/utils";
+
+type MockDatePickerProps = {
+    id?: string;
+    selected: Date | null;
+    onChange: (date: Date | null) => void;
+    customInput: ReactElement<InputHTMLAttributes<HTMLInputElement>>;
+    ariaInvalid?: "true" | "false" | "grammar" | "spelling";
+    ariaDescribedBy?: string;
+};
+
+function formatLocalDate(date: Date): string {
+    const year = date.getFullYear();
+    const month = String(date.getMonth() + 1).padStart(2, "0");
+    const day = String(date.getDate()).padStart(2, "0");
+    return `${year}-${month}-${day}`;
+}
+
+vi.mock("react-datepicker", () => ({
+    default: ({ id, selected, onChange, customInput, ariaInvalid, ariaDescribedBy }: MockDatePickerProps) =>
+        createElement(
+            Fragment,
+            null,
+            cloneElement(customInput, {
+                id,
+                value: selected ? formatLocalDate(selected) : "",
+                "aria-invalid": ariaInvalid,
+                "aria-describedby": ariaDescribedBy,
+                onKeyDown: (event) => event.currentTarget.setAttribute("data-keydown-forwarded", "true"),
+            }),
+            createElement(
+                "button",
+                { type: "button", "aria-label": `${id}-select`, onClick: () => onChange(new Date(2026, 8, 10)) },
+                "select"
+            ),
+            createElement(
+                "button",
+                { type: "button", "aria-label": `${id}-clear`, onClick: () => onChange(null) },
+                "clear"
+            )
+        ),
+}));
+
+describe("FlightSearchForm date picker adapter", () => {
+    it("選択したローカル暦日をUTC変換せず保持する", async () => {
+        const { user } = render(<FlightSearchForm onSubmit={vi.fn()} />);
+
+        await user.click(screen.getByRole("button", { name: "departureDate-select" }));
+
+        expect(screen.getByLabelText("出発日")).toHaveValue("2026-09-10");
+    });
+
+    it("label、error、DatePickerのkeyboard handlerをinputへ接続する", async () => {
+        const { user } = render(<FlightSearchForm onSubmit={vi.fn()} />);
+        const departureDateInput = screen.getByLabelText("出発日");
+
+        fireEvent.keyDown(departureDateInput, { key: "ArrowDown" });
+        expect(departureDateInput).toHaveAttribute("data-keydown-forwarded", "true");
+
+        await user.click(screen.getByRole("button", { name: "departureDate-clear" }));
+        await user.click(screen.getByRole("button", { name: "最安値の航空券を検索" }));
+
+        expect(departureDateInput).toHaveAttribute("aria-invalid", "true");
+        expect(departureDateInput).toHaveAttribute("aria-describedby", "departureDate-error");
+        expect(screen.getByText("出発日を選択してください")).toHaveAttribute("id", "departureDate-error");
+    });
+});
